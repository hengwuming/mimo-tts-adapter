ADAPTER_AUTH_TOKEN=replace-with-a-long-random-token
MIMO_API_KEY=replace-with-your-mimo-api-key
PUBLIC_BASE_URL=https://tts.example.com
LISTEN_ADDR=:8080
MIMO_ENDPOINT=https://api.xiaomimimo.com/v1/chat/completions
MIMO_MODEL=mimo-v2.5-tts
DEFAULT_VOICE=冰糖
DEFAULT_SPEED=25
MAX_REQUEST_BYTES=65536
MAX_TEXT_BYTES=16384
MAX_UPSTREAM_BYTES=33554432
MAX_AUDIO_BYTES=20971520
UPSTREAM_TIMEOUT=90s
MAX_CONCURRENCY=2
RATE_PER_SECOND=1
RATE_BURST=2
MAX_RETRIES=2
MAX_RETRY_DELAY=10s
SHUTDOWN_TIMEOUT=15s
EMOTION_ENABLED=false
EMOTION_ENDPOINT=http://your-openai-compatible-provider:8000/v1/chat/completions
EMOTION_API_KEY=replace-with-your-emotion-model-api-key
EMOTION_MODEL=replace-with-your-emotion-model
EMOTION_TIMEOUT=5s
EMOTION_MAX_RESPONSE_BYTES=8192
EMOTION_MAX_RETRIES=3
EMOTION_RESPONSE_FORMAT=true
# Emotion annotation is optional. On failure, the original text is sent to MiMo.
# It adds one text-model request per paragraph and may increase latency/cost.
# The original paragraph is sent to the configured emotion provider.
# Only enable for a local mock provider; never use this for the public MiMo endpoint.
MIMO_ALLOW_HTTP=false
